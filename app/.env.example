# Solana network the site and wallets use: mainnet-beta | devnet | localnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# RPC endpoint used by the browser (use a paid provider's mainnet URL in production)
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# URL of the Stewra backend (server/ folder, deployed on Railway)
NEXT_PUBLIC_API_URL=http://localhost:4000
# The company wallet orders are paid to. The site refuses to send orders if the server reports a different one.
NEXT_PUBLIC_COMPANY_WALLET_ADDRESS=jdceA46wcDNdk2SSZoZTz3MWdM95n94Fh8EXPQQrR21
