# Network and RPC (use a paid provider's mainnet URL in production)
SOLANA_NETWORK=mainnet-beta
RPC_URL=https://api.mainnet-beta.solana.com

# The company wallet: receives orders and listing fees, pays refunds and payouts, holds mint authority.
COMPANY_WALLET_ADDRESS=jdceA46wcDNdk2SSZoZTz3MWdM95n94Fh8EXPQQrR21
# Optional: where platform fees are sent. Defaults to the company wallet.
# TREASURY_ADDRESS=

# Wallets allowed into /admin (comma-separated). Include the company wallet so it can sign payouts.
ADMIN_WALLETS=jdceA46wcDNdk2SSZoZTz3MWdM95n94Fh8EXPQQrR21

# OPTIONAL automatic payouts. Leave unset to sign every payout yourself in /admin (recommended).
# If set, it must be the secret key of COMPANY_WALLET_ADDRESS; anything else is ignored.
# Never commit it, never put it in the frontend.
# COMPANY_WALLET_SECRET=
# Payouts above this always need an admin signature, and a 24h cap for automatic payouts:
# AUTO_PAYOUT_MAX_LAMPORTS=5000000000
# AUTO_DAILY_MAX_LAMPORTS=50000000000

# Emergency stop that survives restarts (1 = paused): no filings, orders, bell or payouts
# PAYOUTS_PAUSED=0

# Business settings
FEE_BPS=200
SWAP_FEE_BPS=100
MIN_LOCK_SECS=7776000
LISTING_FEE_LAMPORTS=50000000
# MAX_ORDER_LAMPORTS=100000000000
# PRIORITY_MICROLAMPORTS=20000

# Hosting
PORT=4000
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
PUBLIC_API_URL=
SITE_URL=

# Claude API key for roadshow Q&A and prospectus drafts
ANTHROPIC_API_KEY=
